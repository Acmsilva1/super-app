# Example env config for local development
OFFLINE_DEV=true
SUPABASE_URL=http://localhost:3000
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_SCHEMA=superapp
APP_BASE_URL=http://localhost:5173
REQUEST_TIMEOUT_MS=10000
SYSTEM_ANALYSIS_TABLE=system_analysis_logs
SYSTEM_ANALYSIS_DB_TABLE=system_analysis_connections
TELEGRAM_TOKEN=your-telegram-token-here
TELEGRAM_CHAT_ID=your-chat-id-here
PORT=3002
# Optional WhatsApp gateway. Set real values only in Vercel Production.
WHATSAPP_API_ORIGIN=
WHATSAPP_WATER_CALLBACK_TOKEN=
WHATSAPP_INTEGRATION_TOKEN=
WHATSAPP_FINANCE_PROFILE_ID=

# Incoming confirmed purchases; backend only, distinct callback secret.
WHATSAPP_PURCHASE_CALLBACK_TOKEN=
# Opcional/legado. O número da sessão WhatsApp é definido na VPS da mensageria.
WHATSAPP_PURCHASE_OWNER_PHONE=
