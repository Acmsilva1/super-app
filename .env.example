# Example env config for local development
OFFLINE_DEV=true
SUPABASE_URL=http://localhost:3000
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_SCHEMA=superapp
APP_BASE_URL=http://localhost:5173
REQUEST_TIMEOUT_MS=10000
SYSTEM_ANALYSIS_TABLE=system_analysis_logs
SYSTEM_ANALYSIS_DB_TABLE=system_analysis_connections
TELEGRAM_TOKEN=your-telegram-token-here
TELEGRAM_CHAT_ID=your-chat-id-here
PORT=3002

# WhatsApp: configurar SOMENTE no backend do Super App.
# Token igual ao INTEGRATION_TOKEN do projeto de mensageria, nunca ADMIN_TOKEN.
WHATSAPP_ALERTS_ENABLED=false
WHATSAPP_API_ORIGIN=https://seu-projeto-mensageria.vercel.app
WHATSAPP_INTEGRATION_TOKEN=
