{
  "name": "super-app",
  "version": "1.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node server.js",
    "version:sync": "node scripts/sync-app-version.cjs",
    "predev": "node scripts/sync-app-version.cjs",
    "build": "node scripts/sync-app-version.cjs && echo Build complete",
    "test": "npm run test:ux && vitest run --pool threads",
    "test:ux": "node scripts/ux-component-analyst.cjs --path index.html --path api --path features --path lib",
    "doc:validate": "node \"C:/projetos e aplicativos/documentacao/scripts/doc-cli.cjs\" validate",
    "doc:sync": "node \"C:/projetos e aplicativos/documentacao/scripts/doc-cli.cjs\" sync",
    "doc:push": "node \"C:/projetos e aplicativos/documentacao/scripts/doc-cli.cjs\" push",
    "doc:watch": "node \"C:/projetos e aplicativos/documentacao/scripts/doc-cli.cjs\" watch",
    "dev:mock": "node scripts/dev.js",
    "dev:real": "node scripts/dev.js --real",
    "test:telegram": "node scripts/test-telegram.mjs --send"
  },
  "dependencies": {
    "@supabase/postgrest-js": "^2.99.2",
    "@supabase/supabase-js": "^2.45.0",
    "express": "^4.21.2",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "supertest": "^7.1.1",
    "vitest": "^2.1.4",
    "vite": "^5.4.21"
  }
}
