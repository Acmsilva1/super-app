{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/cron-treinar-modelo",
      "destination": "/api/apps?route=cron-treinar-modelo"
    },
    {
      "source": "/api/financeiro-simulador",
      "destination": "/api/financeiro?recurso=simulador"
    },
    {
      "source": "/api/auth-config",
      "destination": "/api/apps?route=auth-config"
    },
    {
      "source": "/api/statistics",
      "destination": "/api/apps?route=statistics"
    },
    {
      "source": "/api/roadmap",
      "destination": "/api/apps?route=roadmap"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-44/GDrJogoPmFnY19bMo81OKbfNBFyeL2oN/fWNxGs8=' 'sha256-Uwhv/d+0IZ695W0j+u142r4TAx2EMsmEKU+XlKs6okY=' 'sha256-XkC92SeFuK8w3+idYWSYQtFTAxGboFBPDvj++TaW5Ks=' https://cdn.jsdelivr.net/npm/motion@11.11.13/dist/motion.min.js; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; worker-src 'self'; trusted-types default dompurify; require-trusted-types-for 'script'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/app-version.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/icon-192.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icon-512.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/admin/usuarios.js": {
      "maxDuration": 60
    },
    "api/saude-alertas-cron.js": {
      "maxDuration": 60
    },
    "api/telegram-webhook.js": {
      "maxDuration": 60
    },
    "api/telegram-alert.py": {
      "maxDuration": 20,
      "excludeFiles": "{node_modules/**,tests/**,db/**,migration/**,docs/**,backgrounds/**}"
    }
  }
}
