# Copie para .env na VPS (mesma pasta do docker-compose.yml) e troque todos os valores.
# Nunca versione o .env real.

# Banco (container db)
POSTGRES_USER=superapp_admin
POSTGRES_PASSWORD=troque-por-senha-forte
POSTGRES_DB=superapp

# Usuario que o PostgREST usa para conectar no banco
AUTHENTICATOR_PASSWORD=troque-por-outra-senha-forte

# Segredo do PostgREST (minimo 32 caracteres) e token de servico gerado com:
#   node scripts/gen-postgrest-token.cjs "<POSTGREST_JWT_SECRET>" "<FIXED_USER_ID>"
POSTGREST_JWT_SECRET=troque-por-segredo-com-pelo-menos-32-caracteres
POSTGREST_TOKEN=cole-aqui-o-token-gerado

# Usuario fixo desta versao de teste (auth.uid() devolve este UUID)
FIXED_USER_ID=f88a6351-317d-425b-afcd-9430c8a34f53
FIXED_USER_EMAIL=andrecarlos.miranda@gmail.com

# Senha de acesso ao site (o navegador pede antes de abrir o app). Minimo 12 caracteres.
BASIC_AUTH_USER=andre
BASIC_AUTH_PASSWORD=troque-por-senha-de-acesso-forte
