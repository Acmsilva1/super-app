# Copie:  cp .env.vps.example .env
# NÃO cole secrets aqui (este arquivo pode ir pro Git).

# ========== 1) OBRIGATÓRIO pra subir o site ==========
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
OFFLINE_DEV=false
SUPERAPP_PUBLISH=127.0.0.1:3000

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public

# ========== 2) Alertas ==========
SAUDE_ALERTS_OWNER_USER_ID=00000000-0000-0000-0000-000000000000
SAUDE_ALERTS_ENABLED=true
CRON_SECRET=

# ========== 3) Mensageria / WhatsApp ==========
WHATSAPP_API_ORIGIN=https://mensageria-andre-zap.duckdns.org
WHATSAPP_INTEGRATION_TOKEN=
WHATSAPP_WATER_CALLBACK_TOKEN=
WHATSAPP_PURCHASE_CALLBACK_TOKEN=
WHATSAPP_FINANCE_PROFILE_ID=1
